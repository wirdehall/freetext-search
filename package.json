{
  "name": "freetext-search",
  "version": "0.1.0",
  "description": "Fast, lightweight freetext search with zero external dependencies",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "search",
    "freetext",
    "filter",
    "typescript",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wirdehall/freetext-search.git"
  },
  "author": "Wirdehall (https://github.com/wirdehall)",
  "homepage": "https://github.com/wirdehall/freetext-search#readme",
  "bugs": {
    "url": "https://github.com/wirdehall/freetext-search/issues"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./react": {
      "types": "./dist/react/index.d.mts",
      "default": "./dist/react/index.mjs"
    }
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "tsdown": "^0.22.0",
    "typescript": "^5.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "npm run build",
    "build:demos": "npm run build --workspaces --if-present",
    "dev:demo:core": "npm run dev --workspace=demos/core",
    "dev:demo:react": "npm run dev --workspace=demos/react"
  },
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "demos/*"
  ]
}
